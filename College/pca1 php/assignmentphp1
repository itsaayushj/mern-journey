9. Indexed Array Operations

<?php

// Create an indexed array
$array = array(25, 10, 45, 30, 15, 50, 5, 35);

// Calculate sum
$sum = 0;

foreach ($array as $value) {
    $sum += $value;
}

// Calculate average
$average = $sum / count($array);

// Find maximum and minimum without max() and min()e
$maximum = $array[0];
$minimum = $array[0];

foreach ($array as $value) {

    if ($value > $maximum) {
        $maximum = $value;
    }

    if ($value < $minimum) {
        $minimum = $value;
    }
}

echo "Sum = " . $sum . "<br>";
echo "Average = " . $average . "<br>";
echo "Maximum = " . $maximum . "<br>";
echo "Minimum = " . $minimum . "<br><br>";

// Sort array in ascending order
sort($array);

echo "Array in ascending order:<br>";

foreach ($array as $value) {
    echo $value . "<br>";
}

?>

