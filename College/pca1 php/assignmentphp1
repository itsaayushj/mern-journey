3. Arithmetic Operations & Variable Swapping

<?php

$a = 15;
$b = 4;

echo "<h3>Before Swapping</h3>";
echo "a = " . $a . "<br>";
echo "b = " . $b . "<br><br>";

// Arithmetic operations
echo "Sum = " . ($a + $b) . "<br>";
echo "Difference = " . ($a - $b) . "<br>";
echo "Product = " . ($a * $b) . "<br>";
echo "Quotient = " . ($a / $b) . "<br>";
echo "Remainder = " . ($a % $b) . "<br><br>";

// Swapping without a third variable
$a = $a + $b;
$b = $a - $b;
$a = $a - $b;

echo "<h3>After Swapping</h3>";
echo "a = " . $a . "<br>";
echo "b = " . $b . "<br>";

?>

